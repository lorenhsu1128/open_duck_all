# ---------------------------------------------------------------------------
# open_duck_all — workspace 層級的 .gitignore
#
# 這一層以 git submodule 的形式把四個獨立 repo 綁在一起：本層只記錄每個子專案
# 「停在哪一個 commit」，內容仍由各子 repo 自己的 .git 與 remote 管理。
#
# clone 這個 workspace 時記得一併取得子專案：
#   git clone --recurse-submodules https://github.com/lorenhsu1128/open_duck_all.git
# 已經 clone 過的話：
#   git submodule update --init --recursive
# 把子專案更新到各自分支的最新版：
#   git submodule update --remote
# ---------------------------------------------------------------------------

# --- 跨專案共用的中間產物（若你在本層做資料交換用的暫存區） ---
/recordings/
/motions/
/policies/
/logs/
/checkpoints/
*.onnx
*.pkl

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version
uv.lock

# --- JAX / MuJoCo / 訓練 ---
runs/
tensorboard/
wandb/
*.mp4
mujoco_saved_obs.pkl

# --- 編輯器 / 作業系統 ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
